# Neon pooled connection string. Keep the real value only in .env.local and Vercel.
DATABASE_URL=postgresql://...

# Neon direct connection string for migrations and npm run setup:owner.
DATABASE_URL_UNPOOLED=postgresql://...

# Used to encrypt and sign Better Auth data. Generate a unique value with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Local URL. In Vercel, use the production site URL instead.
BETTER_AUTH_URL=http://localhost:3000

# Temporary, local-only value for npm run setup:owner. Remove after setup.
OWNER_PASSWORD=change-me
